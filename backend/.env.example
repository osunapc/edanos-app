DATABASE_URL="tu-database-url-aqui"

JWT_SECRET_KEY="tu-secret-key-super-segura"

# AWS S3 para subir archivos
AWS_BUCKET_NAME="tu-bucket"
AWS_BUCKET_REGION="us-east-1"
AWS_ACCESS_KEY="tu-aws-access-key"
AWS_SECRET_ACCESS_KEY="tu-aws-secret-key"

# Email Configuration (Gmail SMTP)
# Instrucciones para obtener App Password:
# 1. Ve a tu cuenta de Google
# 2. Security > 2-Step Verification (activala si no está activa)
# 3. App Passwords > Selecciona "Mail" y "Other"
# 4. Copia la contraseña generada (16 caracteres)
EMAIL_USER="tu-email@gmail.com"
EMAIL_PASSWORD="tu-app-password-de-16-caracteres"
SUPERADMIN_EMAIL="tu-email@gmail.com"

# Frontend URL (para links en emails)
FRONTEND_URL="https://edanos.netlify.app"
# Para desarrollo local: FRONTEND_URL="http://localhost:5173"

# Puerto del servidor
PORT=4500
