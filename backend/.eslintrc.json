{
	"env": {
		"browser": true,
		"es2021": true,
		"node": true
	},
	"extends": ["standard", "plugin:prettier/recommended"],
	"parserOptions": {
		"ecmaVersion": 2021,
		"sourceType": "module"
	},
	"rules": {
		"no-tabs": "off",
		"indent": ["error", "tab"],
		"semi": ["error", "always"],
		"quotes": ["error", "single"],
		"comma-dangle": ["error", "never"],
		"prettier/prettier": [
			"error",
			{
				"useTabs": true,
				"tabWidth": 4,
				"singleQuote": true,
				"trailingComma": "none",
				"semi": true,
				"endOfLine": "auto"
			}
		]
	}
}
